# Environment: Development
# Description: Environment variables used while running `npm run dev`.
# The Fake API (npm run fake-api) runs on port 3000.
VITE_DESTILATECH_API_URL=http://localhost:3000/api/v1
VITE_LANDING_PAGE_URL=https://upc-pre-202620-1asi0730-2620-8084-desti.github.io/destilatech-website/
VITE_PRIME_UI_LICENSE_KEY=your-prime-ui-license-key

# IAM
VITE_USERS_ENDPOINT_PATH=/users
# Billing
VITE_PLANS_ENDPOINT_PATH=/plans
VITE_SUBSCRIPTIONS_ENDPOINT_PATH=/subscriptions
VITE_PAYMENTS_ENDPOINT_PATH=/payments
VITE_CHECKOUT_SESSIONS_ENDPOINT_PATH=/checkout-sessions
# Production & Monitoring
VITE_BATCHES_ENDPOINT_PATH=/batches
VITE_PROCESS_VARIABLES_ENDPOINT_PATH=/process-variables
VITE_SENSOR_READINGS_ENDPOINT_PATH=/sensor-readings
# Inventory & Stock Management
VITE_PRODUCTS_ENDPOINT_PATH=/products
VITE_STOCK_ITEMS_ENDPOINT_PATH=/stock-items
VITE_STOCK_MOVEMENTS_ENDPOINT_PATH=/stock-movements
# Orders & Replenishment
VITE_CUSTOMERS_ENDPOINT_PATH=/customers
VITE_ORDERS_ENDPOINT_PATH=/orders
VITE_REPLENISHMENT_ORDERS_ENDPOINT_PATH=/replenishment-orders
# Alerts & Notifications
VITE_ALERTS_ENDPOINT_PATH=/alerts
